"all","products_to_show":3,"columns_desktop":3,"full_width":false,"show_view_all":false,"view_all_style":"solid","enable_desktop_slider":false,"color_scheme":"background-1","image_ratio":"square","show_secondary_image":false,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"1","swipe_on_mobile":true,"padding_top":48,"padding_bottom":32}},"rich_text_YxchLY":{"type":"rich-text","blocks":{"heading_tDfgib":{"type":"heading","settings":{"heading":"<p>🌸 Why Auckland Loves Mel's Flower Truck<\/p>","heading_size":"h1"}},"text_RzVXgj":{"type":"text","settings":{"text":"<p>✔ <strong>20 years floristry experience<\/strong>  <br\/>✔ <strong>Quality, market‑fresh blooms<\/strong>  <br\/>✔ <strong>Fresh flowers guaranteed<\/strong>  <br\/>✔ <strong>Luxury blooms at affordable prices<\/strong>  <br\/>✔ <strong>Local Auckland business you can trust<\/strong>  <br\/>✔ <strong>Over 100 five‑star Google reviews<\/strong><\/p>"}}},"block_order":["heading_tDfgib","text_RzVXgj"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"background-2","full_width":true,"padding_top":40,"padding_bottom":52}},"2e58f238-6c94-4b65-a718-4bef1ad52876":{"type":"rich-text","blocks":{"template--15859280380083__2e58f238-6c94-4b65-a718-4bef1ad52876-1673259461abab7335-0":{"type":"heading","settings":{"heading":"<p>Stunning, Lasting, Market-Fresh Flowers<\/p><p><\/p><h5>Buy Flower Online, and We'll Deliver With Care In Auckland.<\/h5>","heading_size":"h0"}},"template--15859280380083__2e58f238-6c94-4b65-a718-4bef1ad52876-1673259461abab7335-1":{"type":"text","settings":{"text":""}},"template--15859280380083__2e58f238-6c94-4b65-a718-4bef1ad52876-1673259461abab7335-2":{"type":"button","settings":{"button_label":"","button_link":"","button_style_secondary":false,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}}},"block_order":["template--15859280380083__2e58f238-6c94-4b65-a718-4bef1ad52876-1673259461abab7335-0","template--15859280380083__2e58f238-6c94-4b65-a718-4bef1ad52876-1673259461abab7335-1","template--15859280380083__2e58f238-6c94-4b65-a718-4bef1ad52876-1673259461abab7335-2"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"background-1","full_width":true,"padding_top":20,"padding_bottom":12}},"2fd6ebb9-529e-4eb3-8090-1d78891e6823":{"type":"image-with-text","blocks":{"template--15859280380083__2fd6ebb9-529e-4eb3-8090-1d78891e6823-166890938048a4c229-0":{"type":"heading","settings":{"heading":"Hi, I’m Mel","heading_size":"h1"}},"template--15859280380083__2fd6ebb9-529e-4eb3-8090-1d78891e6823-166890938048a4c229-1":{"type":"text","settings":{"text":"<p>Flowers are the perfect way to get that wow factor. <\/p><p>They look amazing, smell wonderful and really show you care. <\/p><p>After being in the industry a long time, I felt people avoid buying flowers because they think they only last a few days, or that they couldn't afford them, I wanted to change this, so Mel's Flower Truck was born.<\/p><p>Mel's Flower Truck was established in 2022 and after 20 years in the industry, I know how to pick flowers that look great, are lasting and affordable. <\/p><p>So you can love the pop of excitement that flowers can bring. <\/p>","text_style":"body"}}},"block_order":["template--15859280380083__2fd6ebb9-529e-4eb3-8090-1d78891e6823-166890938048a4c229-0","template--15859280380083__2fd6ebb9-529e-4eb3-8090-1d78891e6823-166890938048a4c229-1"],"settings":{"image":"shopify:\/\/shop_images\/f4df4f30-564e-44db-a30f-4bf9fd701602.jpg","height":"large","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-1","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"16623369173bb929c4":{"type":"multicolumn","blocks":{"1662336917a0307bbe-0":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/1d9e0b6b-5b7d-4451-8584-fb9700833f15.jpg","title":"Flowers For  Delivery","text":"<p>Order flowers for birthdays, thank you, celebrations and anniversaries.<\/p>","link_label":"SHOP NOW","link":"shopify:\/\/collections\/all"}},"1662336917a0307bbe-1":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/3C6CE4F6-31BB-4C55-80EC-98F09FBC9D5E.jpg","title":"Flowers For  Your Home or Office","text":"<p>Bring the outside in and showcase your home or office with beautiful seasonal blooms.<\/p>","link_label":"SHOP NOW","link":"shopify:\/\/collections\/all"}},"1662336917a0307bbe-2":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/8C32D7F9-5012-4B1F-BC4E-5E8E1985D93E.jpg","title":"Flowers For  Your Event","text":"<p>Create the wow factor without words for your event, party or birthday.<\/p>","link_label":"LET’S TALK","link":"shopify:\/\/pages\/event-flowers-2"}}},"block_order":["1662336917a0307bbe-0","1662336917a0307bbe-1","1662336917a0307bbe-2"],"settings":{"title":"","heading_size":"h1","image_width":"full","image_ratio":"square","columns_desktop":3,"column_alignment":"left","background_style":"none","button_label":"","button_link":"","color_scheme":"background-1","columns_mobile":"1","swipe_on_mobile":false,"padding_top":0,"padding_bottom":20}},"436d80c3-71c2-471d-b515-a250e6ab624a":{"type":"image-banner","blocks":{"template--15859280380083__436d80c3-71c2-471d-b515-a250e6ab624a-1668909380776cab95-0":{"type":"heading","settings":{"heading":"Fresh Flowers That Make Any Occasion Special","heading_size":"h1"}},"template--15859280380083__436d80c3-71c2-471d-b515-a250e6ab624a-1668909380776cab95-1":{"type":"text","settings":{"text":"Lasting  –  Affordable  –  Seasonal  –  Sustainable  –  Compostable","text_style":"subtitle"}}},"block_order":["template--15859280380083__436d80c3-71c2-471d-b515-a250e6ab624a-1668909380776cab95-0","template--15859280380083__436d80c3-71c2-471d-b515-a250e6ab624a-1668909380776cab95-1"],"disabled":true,"settings":{"image":"shopify:\/\/shop_images\/mels-flower-truck-fresh-flowers.jpg","image_overlay_opacity":0,"image_height":"medium","adapt_height_first_image":false,"desktop_content_position":"middle-left","show_text_box":true,"desktop_content_alignment":"center","color_scheme":"background-1","mobile_content_alignment":"center","stack_images_on_mobile":true,"show_text_below":false}},"19e3d8c7-ef70-4e5d-aec2-a76b203f8fe4":{"type":"rich-text","blocks":{"template--15859280380083__19e3d8c7-ef70-4e5d-aec2-a76b203f8fe4-16684991542afceb6b-1":{"type":"text","settings":{"text":"<p>“I found Mel's flower truck on google. Due to us being in the UK, Mel's 5 star reviews were amazing, so for me, it was no brainier to use Mel to send flowers to our friend in New Zealand. Mel was an absolute delight to deal with, great communication, and the flowers received by our friend were absolutely beautiful.”<\/p><p>~ Tracy<\/p>"}}},"block_order":["template--15859280380083__19e3d8c7-ef70-4e5d-aec2-a76b203f8fe4-16684991542afceb6b-1"],"disabled":true,"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"background-1","full_width":true,"padding_top":40,"padding_bottom":52}},"166233206293ff9a89":{"type":"image-with-text","blocks":{"16623320621722927e-0":{"type":"heading","settings":{"heading":"Hi, I’m Mel","heading_size":"h1"}},"16623320621722927e-1":{"type":"text","settings":{"text":"<p>Flowers are the perfect way to get that wow factor. <\/p><p>They look amazing, smell wonderful and really show you care. <\/p><p>But many people avoid buying flowers because they think they only last a few days. <\/p><p>With 16 years of managing and buying for one of Auckland’s top florists, I know how to pick flowers that look great, are lasting and affordable. <\/p><p>So you can love the pop of excitement that flowers can bring. <\/p>","text_style":"body"}}},"block_order":["16623320621722927e-0","16623320621722927e-1"],"disabled":true,"settings":{"image":"shopify:\/\/shop_images\/What-We-Do-working1.png","height":"adapt","desktop_image_width":"large","layout":"text_first","desktop_content_position":"bottom","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-1","mobile_content_alignment":"left","padding_top":40,"padding_bottom":20}},"fb1a0dc2-b00a-4f66-b6a4-487faa541cb2":{"type":"rich-text","blocks":{"template--15859280380083__fb1a0dc2-b00a-4f66-b6a4-487faa541cb2-16684991542afceb6b-1":{"type":"text","disabled":true,"settings":{"text":"<p>“Not only do they look amazing, but they also fill my house with the most incredible smell! With plenty of buds, so they’ll last for ages. Great value too, much less than some florists out there, without skimping on size or class.”<\/p><p>~ Vicki <\/p>"}}},"block_order":["template--15859280380083__fb1a0dc2-b00a-4f66-b6a4-487faa541cb2-16684991542afceb6b-1"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"background-1","full_width":true,"padding_top":40,"padding_bottom":52}},"522c02da-05ca-4bcf-936f-101342b0bda5":{"type":"image-with-text","blocks":{"template--15859280380083__522c02da-05ca-4bcf-936f-101342b0bda5-166950339058266bad-0":{"type":"heading","settings":{"heading":"Can’t wait for your flowers? Come and choose your blooms in person","heading_size":"h1"}},"template--15859280380083__522c02da-05ca-4bcf-936f-101342b0bda5-166950339058266bad-1":{"type":"text","settings":{"text":"<p>69A Merton Road, St Johns, Auckland<\/p><p>(In the  SwimTastic Carpark)<\/p><p>HOURS<br\/>Mon, Wed, Thurs & Fri: 9am - 12pm<\/p><p>Tuesdays - Working from home<\/p>","text_style":"body"}},"template--15859280380083__522c02da-05ca-4bcf-936f-101342b0bda5-166950339058266bad-2":{"type":"button","settings":{"button_label":"GET IN TOUCH","button_link":"shopify:\/\/pages\/contact-us"}}},"block_order":["template--15859280380083__522c02da-05ca-4bcf-936f-101342b0bda5-166950339058266bad-0","template--15859280380083__522c02da-05ca-4bcf-936f-101342b0bda5-166950