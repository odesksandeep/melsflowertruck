          "type": "heading",
          "settings": {
            "heading": "<p>The wow factor for every event</p>",
            "heading_size": "h0"
          }
        },
        "template--15859280478387__8f7f6e84-f3a9-4345-bf14-f28d1339257f-1675197756d10d388b-1": {
          "type": "text",
          "settings": {
            "text": "<p>An event just isn’t complete without stunning blooms that create a full-sense wow factor.</p><p>Fully tailored to your event, I can create custom installations that really make your party, event or birthday pop. </p><p><span style=\"text-decoration:underline\">Email or call me </span>to discuss your flower needs.</p>"
          }
        }
      },
