      "blocks": {
        "template--15859280478387__912a4554-b521-442c-a251-58ff7a8a79c7-16689122917122b8e5-0": {
          "type": "heading",
          "settings": {
            "heading": "<p>Flowers Bring The Joy To Your Day</p>",
            "heading_size": "h1"
          }
        },
        "template--15859280478387__912a4554-b521-442c-a251-58ff7a8a79c7-16689122917122b8e5-1": {
          "type": "text",
          "settings": {
            "text": "<p>Everyone deserves to enjoy flowers.        </p><p>                                                                                 Flowers captivate all our senses. </p><p>They look wonderful and smell amazing, and we can’t help but reach out                                       and feel the delicate blooms. </p><p>Giving, receiving and being around flowers lift our spirits and make us feel special. </p>"
          }
        },
