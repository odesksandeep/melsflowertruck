{% doc %}
  @prompt
    On the product page, the price display should show "From $80 - $180" when a product has multiple variants at different prices. Currently it only shows "$80". Fix the price display so it shows the full price range in the format "From $[min price] - $[max price]" when the product has variants with varying prices (product.price_varies is true).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-price-range-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-price-range__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
  }

  .ai-price-range__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: {{ block.settings.label_weight }};
  }

  .ai-price-range__prices-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .ai-price-range__price-{{ ai_gen_id }} {
    font-weight: {{ block.settings.price_weight }};
  }

  .ai-price-range__separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
  }

  .ai-price-range__compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_size }}px;
    color: {{ block.settings.compare_color }};
    text-decoration: line-through;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .ai-price-range__container-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.9);
    }

    .ai-price-range__label-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.label_size }}px * 0.9);
    }

    .ai-price-range__compare-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.compare_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-price-range-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-price-range__container-{{ ai_gen_id }}">
    {% if product.price_varies %}
      {% if block.settings.show_from_label %}
        <span class="ai-price-range__label-{{ ai_gen_id }}">{{ block.settings.from_label }}</span>
      {% endif %}
      <div class="ai-price-range__prices-{{ ai_gen_id }}">
        <span class="ai-price-range__price-{{ ai_gen_id }}">
          {{ product.price_min | money }}
        </span>
        <span class="ai-price-range__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-price-range__price-{{ ai_gen_id }}">
          {{ product.price_max | money }}
        </span>
      </div>
      {% if product.compare_at_price_max > product.price_max %}
        <span class="ai-price-range__compare-{{ ai_gen_id }}">
          {{ product.compare_at_price_max | money }}
        </span>
      {% endif %}
    {% else %}
      <div class="ai-price-range__prices-{{ ai_gen_id }}">
        <span class="ai-price-range__price-{{ ai_gen_id }}">
          {{ product.price | money }}
        </span>
      </div>
      {% if product.compare_at_price > product.price %}
        <span class="ai-price-range__compare-{{ ai_gen_id }}">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Price range display",
  "settings": [
    {
      "type": "header",
      "content": "Price range"
    },
    {
      "type": "checkbox",
      "id": "show_from_label",
      "label": "Show 'From' label",
      "default": true,
      "info": "Displays when product has varying prices"
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "From label text",
      "default": "From"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Price separator",
      "default": "-"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Label style"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#3d3935"
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Price style"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#3d3935"
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Price weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#3d3935"
    },
    {
      "type": "header",
      "content": "Compare at price"
    },
    {
      "type": "range",
      "id": "compare_size",
      "label": "Compare price size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare price color",
      "default": "#3d3935"
    }
  ],
  "presets": [
    {
      "name": "Price range display"
    }
  ]
}
{% endschema %}
